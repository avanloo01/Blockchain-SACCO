APP_ENV=dev
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_BOT_TOKEN=replace_with_real_token
TELEGRAM_WEBHOOK_SECRET=
GOVERNANCE_THRESHOLD_USD=100
POOL_UTILIZATION_CAP_PERCENT=60
SERVICE_FEE_PERCENT=1.0
PAYMENT_PROVIDER=crossmint
SOLANA_TREASURY_ADDRESS=
SOLANA_RPC_URL=https://api.devnet.solana.com
CROSSMINT_SERVER_API_KEY=
# Email of the SACCO Crossmint account that owns CROSSMINT_WALLET_ADDRESS.
# Must be set so the treasury wallet is linked to the SACCO account, not the member.
CROSSMINT_TREASURY_EMAIL=
# For Crossmint checkout, set this to the SACCO's Crossmint-managed treasury wallet.
# Leave SOLANA_TREASURY_ADDRESS for direct Solana flows and legacy fallbacks.
WEBSITE_URL=https://lemaiyanlabs.org
CROSSMINT_WALLET_ADDRESS=
CROSSMINT_TOKEN_LOCATOR=solana:4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
CROSSMINT_SLIPPAGE_BPS=500

# Supabase PostgreSQL (via PgBouncer connection pooling)
DATABASE_URL="postgresql://postgres.xxx:password@aws-1-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection for migrations
DIRECT_URL="postgresql://postgres.xxx:password@aws-1-region.pooler.supabase.com:5432/postgres"
